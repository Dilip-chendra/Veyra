# Database configuration (SQLite for turnkey zero-config dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Authentication secret (at least 32 characters)
AUTH_SECRET="veyra_jwt_auth_secret_key_production_grade_32_chars"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LLM Providers (Optional for cloud models; intelligent local reasoning fallback active when unconfigured)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Real-time Voice & TTS Providers (Optional: browser Web Speech API & Web Audio active with zero configuration)
ELEVENLABS_API_KEY=""
OPENAI_TTS_VOICE="alloy"

# Real-time Avatar Providers (Optional: high-fidelity procedural 3D digital human WebGL engine active with zero configuration)
TAVUS_API_KEY=""
HEYGEN_API_KEY=""
SIMLI_API_KEY=""

# GitHub Integration (Optional: for analyzing private repos or higher GitHub rate limits)
GITHUB_TOKEN=""

# Code Execution API
PISTON_API_URL="https://emkc.org/api/v2/piston"

# Billing & Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
