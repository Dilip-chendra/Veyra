# Database configuration (SQLite for turnkey zero-config dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Authentication secret (at least 32 characters)
AUTH_SECRET="veyra_jwt_auth_secret_key_production_grade_32_chars"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LLM Providers (Optional for cloud models; intelligent local reasoning fallback active when unconfigured)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Cartesia Voice AI — SERVER-SIDE ONLY. NEVER use NEXT_PUBLIC_ prefix.
# TTS: Sonic-3.6 (interviewer voice), STT: Ink-2 (candidate transcription)
CARTESIA_API_KEY=""
# Voice IDs — get from https://play.cartesia.ai or GET /voices API
CARTESIA_MARCUS_VOICE_ID="694f9389-aac1-45b6-b726-9d9369183238"
CARTESIA_ELENA_VOICE_ID="bf991597-6135-4318-b45f-3b23c0a12c2d"

# GitHub Integration (Optional: for analyzing private repos or higher GitHub rate limits)
GITHUB_TOKEN=""

# Code Execution API
PISTON_API_URL="https://emkc.org/api/v2/piston"

# Billing & Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

